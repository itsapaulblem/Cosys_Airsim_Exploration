# AirSim Environment Configuration Template
# Copy this file to .env and fill in your secure values
# DO NOT commit .env files with actual secrets to version control

# =======================
# AIRSIM CONFIGURATION
# =======================
AIRSIM_HOST_IP=host.docker.internal
AIRSIM_HOST_PORT=41451

# =======================
# ROS2 CONFIGURATION
# =======================
ROS_DOMAIN_ID=0
LAUNCH_MODE=multi
ENABLE_COORDINATION=true
RPC_TIMEOUT=10.0
DEBUG=false
LAUNCH_RVIZ=false

# =======================
# PX4 CONFIGURATION
# =======================
PX4_SIM_HOSTNAME=host.docker.internal
PX4_SIM_MODEL=none_iris
PX4_HOME_LAT=43.06659659989448
PX4_HOME_LON=-115.85470390486812
PX4_HOME_ALT=0.0
PX4_SYS_AUTOSTART=10016
SWARM_ID=1
SWARM_SIZE=3
MAX_DRONES=3

# =======================
# DATABASE CONFIGURATION (REQUIRED FOR POSTGRES)
# =======================
# Set these to secure values for production use
POSTGRES_DB=drone_statistics
POSTGRES_USER=airsim_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_SCHEMA=drone_stats
POSTGRES_HOST_PORT=5432

# Database performance settings
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30

# Database storage paths (optional, defaults provided)
POSTGRES_DATA_PATH=./data/postgres_stats_data
POSTGRES_LOGS_PATH=./data/postgres_stats_logs
POSTGRES_BACKUPS_PATH=./data/postgres_stats_backups

# TimescaleDB tuning
TS_TUNE_MEMORY=1GB
TS_TUNE_MAX_CONNS=100

# =======================
# PGADMIN CONFIGURATION (DEVELOPMENT ONLY)
# =======================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_HOST_PORT=8080

# =======================
# BACKUP CONFIGURATION
# =======================
BACKUP_ENABLED=true
BACKUP_INTERVAL=daily
BACKUP_RETENTION=7

# =======================
# PROJECT PATHS
# =======================
PROJECT_ROOT=/path/to/your/project/root

# =======================
# SECURITY NOTES
# =======================
# 1. Generate strong passwords for POSTGRES_PASSWORD and PGADMIN_PASSWORD
# 2. Use different passwords for development and production environments
# 3. Never commit .env files containing actual secrets to version control
# 4. Consider using a secrets management system for production deployments
# 5. Rotate passwords regularly and audit access logs