#!/bin/sh
# shellcheck disable=SC2154
# Network MAVLink Configuration for External Connectivity
# Based on PX4's standard mavlink configuration with external target support

# Get instance from environment (converted from user-friendly drone numbers)
px4_instance=${PX4_INSTANCE:-0}

# Target host configuration
# Auto-detect based on Docker network mode
# - 127.0.0.1 (host network mode - containers share host's network stack)
# - PX4_SIM_HOSTNAME (bridge mode with containerized AirSim)
# - host.docker.internal (Docker Desktop/bridge mode with native AirSim)
# - 192.168.65.254 (Docker Desktop WSL2 gateway - legacy)
# Override via environment variable MAVLINK_TARGET for custom setups

if [ -n "$HOST_NETWORK_MODE" ] || [ "$NETWORK_MODE" = "host" ]; then
    # Host network mode: containers share host's network stack
    MAVLINK_TARGET=${MAVLINK_TARGET:-127.0.0.1}
    echo "Network Mode: host (using localhost)"
else
    # Bridge network mode: use same target as simulator connection
    # If PX4_SIM_HOSTNAME is set (e.g., "airsim-container"), use it for MAVLink too
    # Otherwise fall back to host.docker.internal (Docker Desktop) or explicit IP
    MAVLINK_TARGET=${MAVLINK_TARGET:-${PX4_SIM_HOSTNAME:-airsim-container}}
    echo "Network Mode: bridge (using $MAVLINK_TARGET)"
fi

# Port calculations following industry standards
# Standard MAVLink ports for external connections
udp_gcs_port_remote=$((14550+px4_instance))        # QGroundControl: 14550, 14551, 14552...
udp_offboard_port_remote=$((14540+px4_instance))   # API/MAVSDK: 14540, 14541, 14542...

# Local container ports (PX4 internal)
udp_gcs_port_local=$((18570+px4_instance))         # Internal GCS port
udp_offboard_port_local=$((14580+px4_instance))    # Internal offboard port

# Additional onboard links (for completeness)
udp_onboard_payload_port_local=$((14280+px4_instance))
udp_onboard_payload_port_remote=$((14030+px4_instance))
udp_onboard_gimbal_port_local=$((13030+px4_instance))
udp_onboard_gimbal_port_remote=$((13280+px4_instance))

# Handle port overlaps for more than 10 instances
[ "$px4_instance" -gt 9 ] && udp_offboard_port_remote=14549

echo "🌐 Network MAVLink Configuration"
echo "Instance: $px4_instance"
echo "Target Host: $MAVLINK_TARGET"
echo "QGC Port: $MAVLINK_TARGET:$udp_gcs_port_remote"
echo "API Port: $MAVLINK_TARGET:$udp_offboard_port_remote"

# ================================
# AIRSIM CONNECTION VALIDATION
# ================================
echo "Validating AirSim connectivity..."

# Test 1: Ping test (informational only)
if timeout 5 ping -c 1 $MAVLINK_TARGET > /dev/null 2>&1; then
    echo "AirSim host reachable at $MAVLINK_TARGET (ping)"
else
    echo "Warning: Cannot ping $MAVLINK_TARGET (may still work with direct connection)"
fi

# UDP port info (no connectivity test - UDP is connectionless)
AIRSIM_CONTROL_PORT=$((14540+px4_instance))
echo "AirSim MAVLink UDP port: $AIRSIM_CONTROL_PORT (will bind on first packet exchange)"

# ================================
# PRIMARY GCS LINK (QGroundControl)
# ================================
echo "Starting GCS MAVLink link..."
mavlink start -x -u $udp_gcs_port_local -r 4000000 -f -t $MAVLINK_TARGET -o $udp_gcs_port_remote

# Wait before starting next link to avoid port conflicts
sleep 0.5

# GCS-optimized message streams
# OPTIMIZED RATES: Reduced non-critical streams to save bandwidth
# Focus on maintaining control loop integrity while reducing overhead
mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u $udp_gcs_port_local
mavlink stream -r 50 -s LOCAL_POSITION_NED -u $udp_gcs_port_local
mavlink stream -r 50 -s GLOBAL_POSITION_INT -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE_QUATERNION -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE_TARGET -u $udp_gcs_port_local
mavlink stream -r 50 -s SERVO_OUTPUT_RAW_0 -u $udp_gcs_port_local  # REDUCED: 50→20 Hz
mavlink stream -r 20 -s RC_CHANNELS -u $udp_gcs_port_local           # REDUCED: 10→5 Hz
mavlink stream -r 10 -s OPTICAL_FLOW_RAD -u $udp_gcs_port_local

# Essential GCS streams
# OPTIMIZED: Maintain critical data while reducing overhead
mavlink stream -r 1 -s HEARTBEAT -u $udp_gcs_port_local
mavlink stream -r 10 -s GPS_RAW_INT -u $udp_gcs_port_local           # REDUCED: 5→10 Hz (actually increased for better precision)
mavlink stream -r 1 -s BATTERY_STATUS -u $udp_gcs_port_local         # REDUCED: 5→1 Hz (slow-changing data)
mavlink stream -r 10 -s VFR_HUD -u $udp_gcs_port_local               # REDUCED: 20→10 Hz
mavlink stream -r 2 -s EXTENDED_SYS_STATE -u $udp_gcs_port_local

# ================================
# API/OFFBOARD LINK (MAVSDK, DroneKit)
# ================================
echo "Starting API/Offboard MAVLink link..."
mavlink start -x -u $udp_offboard_port_local -r 4000000 -f -m onboard -t $MAVLINK_TARGET -o $udp_offboard_port_remote

# High-rate streams for MAVROS/API clients (explicitly configured)
# These rates are critical for stable offboard control and takeoff
echo "  Configuring high-rate offboard streams..."

# Critical control loop feedback (100 Hz)
mavlink stream -r 100 -s HIGHRES_IMU -u $udp_offboard_port_local
mavlink stream -r 100 -s ATTITUDE -u $udp_offboard_port_local
mavlink stream -r 100 -s ATTITUDE_QUATERNION -u $udp_offboard_port_local
mavlink stream -r 100 -s LOCAL_POSITION_NED -u $udp_offboard_port_local

# Position and control targets (50 Hz)
mavlink stream -r 50 -s GLOBAL_POSITION_INT -u $udp_offboard_port_local
mavlink stream -r 50 -s ATTITUDE_TARGET -u $udp_offboard_port_local
mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u $udp_offboard_port_local
# mavlink stream -r 50 -s ACTUATOR_OUTPUTS -u $udp_offboard_port_local  # Not supported in this PX4 version
mavlink stream -r 50 -s ALTITUDE -u $udp_offboard_port_local

# Navigation and GPS (moderate rate)
# OPTIMIZED: Balanced precision vs bandwidth
mavlink stream -r 10 -s GPS_RAW_INT -u $udp_offboard_port_local          # REDUCED: 20→10 Hz
mavlink stream -r 10 -s NAV_CONTROLLER_OUTPUT -u $udp_offboard_port_local

# Essential status (low rate)
# OPTIMIZED: Slow-changing data at minimal update rate
mavlink stream -r 1 -s BATTERY_STATUS -u $udp_offboard_port_local        # REDUCED: 10→1 Hz
mavlink stream -r 5 -s SYSTEM_TIME -u $udp_offboard_port_local           # REDUCED: 10→5 Hz
mavlink stream -r 5 -s EXTENDED_SYS_STATE -u $udp_offboard_port_local    # REDUCED: 10→5 Hz
# mavlink stream -r 5 -s MISSION_CURRENT -u $udp_offboard_port_local  # Not supported in this PX4 version
mavlink stream -r 1 -s HEARTBEAT -u $udp_offboard_port_local

# Wait before starting next link
sleep 0.5

# ================================
# ONBOARD PAYLOAD LINK (Camera/Gimbal)
# ================================
echo "Starting onboard payload link..."
mavlink start -x -u $udp_onboard_payload_port_local -r 4000 -f -m onboard -o $udp_onboard_payload_port_remote

# Wait before starting next link
sleep 0.3

# ================================
# GIMBAL LINK
# ================================
echo "Starting gimbal link..."
mavlink start -x -u $udp_onboard_gimbal_port_local -r 400000 -f -m gimbal -o $udp_onboard_gimbal_port_remote

# Wait for link initialization
sleep 0.3

# ================================
# SIMULATOR-SPECIFIC LINKS
# ================================

# SIH (Simulation in Hardware) link
if [ "$PX4_SIMULATOR" = "sihsim" ]; then
    echo "Configuring SIH simulator link..."
    udp_sihsim_port_local=$((19450+px4_instance))
    udp_sihsim_port_remote=$((19410+px4_instance))
    mavlink start -x -u $udp_sihsim_port_local -r 400000 -m custom -o $udp_sihsim_port_remote
    mavlink stream -r 200 -s HIL_ACTUATOR_CONTROLS -u $udp_sihsim_port_local
    mavlink stream -r 25 -s HIL_STATE_QUATERNION -u $udp_sihsim_port_local
fi

# AirSim-specific configuration
# NOTE: High-rate streams now configured globally above (100 Hz IMU, 50 Hz ATTITUDE)
# No additional AirSim-specific configuration needed
if [ "$PX4_SIMULATOR" = "airsim" ] || [ -n "$AIRSIM_ENABLED" ]; then
    echo "AirSim mode detected - using high-rate stream configuration"
    # All streams already configured in GCS and offboard sections above
fi

# ================================
# STATUS AND COMPLETION
# ================================

# Wait for instances to start
sleep 1

echo ""
echo "Network MAVLink Configuration Complete!"
echo ""
echo "Connection Information:"
echo "  QGroundControl: $MAVLINK_TARGET:$udp_gcs_port_remote"
echo "  MAVSDK/API: $MAVLINK_TARGET:$udp_offboard_port_remote"
echo "  Payload Link: localhost:$udp_onboard_payload_port_remote"
echo "  Gimbal Link: localhost:$udp_onboard_gimbal_port_remote"
echo ""
echo "Status Check:"
echo "  mavlink status"
echo ""
echo "Debug Info:"
echo "  Instance: $px4_instance"
echo "  Target: $MAVLINK_TARGET"
echo "  PX4_SIMULATOR: ${PX4_SIMULATOR:-none}"

# Display mavlink status
mavlink status