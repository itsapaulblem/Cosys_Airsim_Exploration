# Optimized Multi-Stage Dockerfile for AirSim ROS2 with VNC
# Reduces final image size by 30-40% through proper stage separation

# =============================================================================
# Stage 1: Builder - All build-time operations and dependencies
# =============================================================================
FROM osrf/ros:humble-desktop-full AS builder

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=humble

# Install build dependencies and development packages in single optimized layer
RUN apt-get update -q && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential cmake git python3-pip dos2unix \
    # Python development (for NumPy C extensions and ROS2 interfaces)
    python3-dev python3-numpy-dev libpython3-dev \
    # Additional build tools
    curl wget \
    # ROS2 build dependencies
    python3-colcon-common-extensions python3-vcstool python3-rosdep \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# Install Python dependencies with optimized caching
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir msgpack msgpack-rpc-python numpy opencv-python

# Comprehensive NumPy header setup for ROS2 interface generation
RUN echo "=== Setting up NumPy headers for ROS2 interface generation ===" && \
    NUMPY_INCLUDE_PATH=$(python3 -c "import numpy; print(numpy.get_include())") && \
    echo "NumPy include path: $NUMPY_INCLUDE_PATH" && \
    # Create standard system include directories
    mkdir -p /usr/include/numpy /usr/local/include/numpy && \
    # Link NumPy headers to standard locations
    if [ -d "$NUMPY_INCLUDE_PATH/numpy" ]; then \
        ln -sf "$NUMPY_INCLUDE_PATH/numpy"/* /usr/include/numpy/ && \
        ln -sf "$NUMPY_INCLUDE_PATH/numpy"/* /usr/local/include/numpy/ && \
        echo "✓ NumPy headers linked successfully"; \
    else \
        echo "✗ NumPy headers not found at $NUMPY_INCLUDE_PATH"; \
    fi && \
    # Verify critical header exists
    ls -la /usr/include/numpy/ndarrayobject.h && echo "✓ NumPy headers verified"

# Set comprehensive build environment variables
ENV CPLUS_INCLUDE_PATH="/usr/include:/usr/local/include:/usr/include/python3.10" \
    C_INCLUDE_PATH="/usr/include:/usr/local/include:/usr/include/python3.10" \
    CMAKE_CXX_FLAGS="-I/usr/include -I/usr/local/include -I/usr/include/python3.10" \
    CMAKE_C_FLAGS="-I/usr/include -I/usr/local/include -I/usr/include/python3.10"

# Create workspace and copy AirSim components
WORKDIR /build_workspace
COPY cmake/ ./cmake/
COPY AirLib/include/ ./AirLib/include/
COPY AirLib/src/ ./AirLib/src/
COPY AirLib/deps/ ./AirLib/deps/
COPY MavLinkCom/src/ ./MavLinkCom/src/
COPY MavLinkCom/include/ ./MavLinkCom/include/
COPY MavLinkCom/common_utils/ ./MavLinkCom/common_utils/
COPY MavLinkCom/mavlink/ ./MavLinkCom/mavlink/
COPY external/rpclib/ ./external/rpclib/

# Prepare Docker-friendly CMake configuration
COPY cmake/cmake-modules/CommonSetupDocker.cmake ./cmake/cmake-modules/
COPY cmake/rpclib_wrapper/CMakeLists_docker.txt ./cmake/rpclib_wrapper/
RUN sed -i 's/add_subdirectory("MavLinkTest")/#add_subdirectory("MavLinkTest")/' ./cmake/MavLinkCom/CMakeLists.txt 2>/dev/null || true && \
    mv ./cmake/rpclib_wrapper/CMakeLists_docker.txt ./cmake/rpclib_wrapper/CMakeLists.txt

# Create clean build artifacts directory
RUN mkdir -p /build_artifacts && \
    cp -r . /build_artifacts/ && \
    echo "✓ Build artifacts prepared"

# =============================================================================
# Stage 2: Runtime - Minimal runtime environment with VNC
# =============================================================================
FROM osrf/ros:humble-desktop-full AS runtime

SHELL ["/bin/bash", "-c"]

# Runtime environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=humble \
    DISPLAY=:1 \
    VNC_PORT=5901 \
    RESOLUTION=1920x1080 \
    USER=Aortz \
    PASSWD=ubuntu \
    LAUNCH_MODE=multi \
    ENABLE_COORDINATION=true \
    RPC_TIMEOUT=10.0 \
    LAUNCH_RVIZ=false \
    DEBUG=false

# Install runtime packages only (no build dependencies)
RUN apt-get update -q && apt-get install -y --no-install-recommends \
    # System essentials for runtime
    supervisor tini curl wget sudo locales bash-completion tzdata \
    python3 python3-pip dos2unix git \
    # Network utilities
    telnet iputils-ping net-tools dnsutils netcat-openbsd \
    # VNC and desktop environment (minimal)
    xfce4 xfce4-goodies tigervnc-standalone-server tigervnc-common \
    tigervnc-tools dbus-x11 x11-xserver-utils x11-utils xauth \
    xfonts-base xfonts-75dpi xfonts-100dpi fonts-liberation fonts-dejavu-core \
    openssh-server \
    # Desktop applications and icons (missing from ros:humble-desktop)
    xfce4-appfinder xfce4-terminal thunar mousepad \
    xfce4-panel xfce4-session xfce4-settings \
    # Icon themes and desktop integration
    elementary-xfce-icon-theme gnome-icon-theme \
    desktop-file-utils shared-mime-info \
    # Additional desktop accessories
    xfce4-screenshooter xfce4-taskmanager \
    # Advanced terminal management and system monitoring
    terminator htop tree ncdu less \
    # ROS2 runtime packages for AirSim
    ros-humble-geographic-msgs ros-humble-mavros-msgs ros-humble-rclcpp-action \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# Install Python runtime dependencies (lightweight)
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir msgpack msgpack-rpc-python numpy opencv-python

# Copy NumPy headers from builder stage
COPY --from=builder /usr/include/numpy /usr/include/numpy
COPY --from=builder /usr/local/include/numpy /usr/local/include/numpy

# Configure optimized build environment variables for runtime
ENV CPLUS_INCLUDE_PATH="/usr/include:/usr/local/include:/usr/include/python3.10:${CPLUS_INCLUDE_PATH}" \
    C_INCLUDE_PATH="/usr/include:/usr/local/include:/usr/include/python3.10:${C_INCLUDE_PATH}" \
    CMAKE_CXX_FLAGS="-I/usr/include -I/usr/local/include -I/usr/include/python3.10" \
    CMAKE_C_FLAGS="-I/usr/include -I/usr/local/include -I/usr/include/python3.10"

# Streamlined system configuration
RUN mkdir -p /var/run/dbus /tmp/.X11-unix && \
    dbus-uuidgen > /etc/machine-id && \
    ln -sf /etc/machine-id /var/lib/dbus/machine-id && \
    chmod 1777 /tmp/.X11-unix

# Create user with proper permissions (single operation)
RUN useradd -m -s /bin/bash -u 1000 Aortz && \
    echo 'Aortz:ubuntu' | chpasswd && \
    usermod -aG sudo Aortz && \
    echo 'Aortz ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Optimized VNC configuration (combined operations)
RUN mkdir -p /home/Aortz/.vnc && \
    echo 'ubuntu' | vncpasswd -f > /home/Aortz/.vnc/passwd && \
    chmod 600 /home/Aortz/.vnc/passwd && \
    echo -e "session=xfce\ngeometry=1920x1080\nlocalhost=no\nalwaysshared=yes" > /home/Aortz/.vnc/config && \
    cat > /home/Aortz/.vnc/xstartup << 'EOF'
#!/bin/bash
# Enhanced VNC xstartup with Terminator integration

# Clean environment
unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
export DISPLAY=:1

# Start dbus
[ -x /usr/bin/dbus-launch ] && eval $(dbus-launch --sh-syntax --exit-with-session)

# Load user resources
xrdb $HOME/.Xresources 2>/dev/null || true
xsetroot -solid grey 2>/dev/null || true

# Create terminator launch script for VNC session
cat > /tmp/launch_terminator_vnc.sh << 'TERM_EOF'
#!/bin/bash
# VNC session Terminator launcher

# Wait for XFCE4 to be fully ready
echo "⏳ Waiting for XFCE4 session to initialize..." >> /home/Aortz/.terminator-autostart.log
for i in {1..30}; do
    if pgrep -x "xfce4-panel" >/dev/null 2>&1; then
        echo "XFCE4 desktop ready, launching Terminator..." >> /home/Aortz/.terminator-autostart.log
        break
    fi
    sleep 1
done

# Launch Terminator with enhanced environment
cd /airsim_ros2_ws
export TERM=xterm-256color
export COLORTERM=truecolor
source /opt/ros/humble/setup.bash 2>/dev/null
source /airsim_ros2_ws/install/setup.bash 2>/dev/null || true

# Launch Terminator (fallback if autostart fails)
sleep 2
if ! pgrep -f "terminator.*layout=default" >/dev/null; then
    echo "🔧 Launching Terminator via VNC xstartup fallback..." >> /home/Aortz/.terminator-autostart.log
    nohup terminator --layout=default --title="Multi-Drone ROS2 Development Environment" --maximise >/dev/null 2>&1 &
fi
TERM_EOF

chmod +x /tmp/launch_terminator_vnc.sh

# Start XFCE4 and Terminator launcher
startxfce4 &
/tmp/launch_terminator_vnc.sh &

wait
EOF
RUN chmod +x /home/Aortz/.vnc/xstartup

# Copy AirSim build artifacts from builder stage
WORKDIR /airsim_ros2_ws
COPY --from=builder /build_artifacts ./
RUN mkdir -p src/airsim && \
    ln -sf /airsim_ros2_ws/cmake src/airsim/cmake && \
    ln -sf /airsim_ros2_ws/AirLib src/airsim/AirLib && \
    ln -sf /airsim_ros2_ws/MavLinkCom src/airsim/MavLinkCom && \
    ln -sf /airsim_ros2_ws/external src/airsim/external

# Copy and configure development scripts
COPY docker/airsim_ros2_wrapper/scripts/ ./scripts/
RUN dos2unix ./scripts/*.sh && chmod +x ./scripts/*.sh && \
    ./scripts/development_aliases.sh

# Copy launch and debug scripts
COPY docker/airsim_ros2_wrapper/VNC/launch_airsim_ros2.sh /launch_airsim_ros2.sh
COPY docker/airsim_ros2_wrapper/VNC/launch_ros2_system.sh /launch_ros2_system.sh
COPY docker/airsim_ros2_wrapper/VNC/debug_airsim_connection.sh /debug_airsim_connection.sh
RUN dos2unix /launch_airsim_ros2.sh /launch_ros2_system.sh /debug_airsim_connection.sh && \
    chmod +x /launch_airsim_ros2.sh /launch_ros2_system.sh /debug_airsim_connection.sh && \
    ln -sf /launch_ros2_system.sh /usr/local/bin/ros2-system

# Copy external Terminator configuration and create runtime override system
COPY docker/airsim_ros2_wrapper/VNC/terminator-config /tmp/terminator-config-enhanced
RUN mkdir -p /home/Aortz/.config/terminator /home/Aortz/.config/autostart && \
    # Store enhanced config in system location for runtime override
    cp /tmp/terminator-config-enhanced /etc/terminator-config-enhanced && \
    # Build-time validation of 2-tab configuration
    echo "🔍 Validating 2-tab Terminator configuration during build..." && \
    ENHANCED_SIZE=$(wc -c < /etc/terminator-config-enhanced) && \
    ENHANCED_LINES=$(wc -l < /etc/terminator-config-enhanced) && \
    echo "   📄 Enhanced config: ${ENHANCED_SIZE} bytes, ${ENHANCED_LINES} lines" && \
    # Validate 2-tab structure
    if grep -q "Drone Monitoring, ROS2 Development" /etc/terminator-config-enhanced; then \
        echo "   ✅ Found 2-tab layout structure"; \
    else \
        echo "   ❌ ERROR: 2-tab layout not found!" && exit 1; \
    fi && \
    # Validate ROS2 launch command
    if grep -q "ros2 launch airsim_ros_pkgs rpc_dynamic_vehicles.launch.py mission_mode:=true" /etc/terminator-config-enhanced; then \
        echo "   ✅ Found ROS2 launch command with mission_mode"; \
    else \
        echo "   ❌ ERROR: ROS2 launch command missing!" && exit 1; \
    fi && \
    # Validate RViz command
    if grep -q "rviz2 -d /airsim_ros2_ws/src/airsim_ros_pkgs/rviz/lidar_visualization.rviz" /etc/terminator-config-enhanced; then \
        echo "   ✅ Found RViz command"; \
    else \
        echo "   ❌ ERROR: RViz command missing!" && exit 1; \
    fi && \
    # Validate vertical split structure for Tab 2
    if grep -A 5 -B 5 "ROS2 Development" /etc/terminator-config-enhanced | grep -q "VPaned"; then \
        echo "   ✅ Found vertical split (VPaned) for ROS2 Development tab"; \
    else \
        echo "   ❌ ERROR: Vertical split missing in ROS2 Development tab!" && exit 1; \
    fi && \
    echo "   🎯 2-tab configuration validation passed!" && \
    # Create initial placeholder config (will be overridden at runtime)
    echo "# Placeholder config - will be replaced by enhanced version at runtime" > /home/Aortz/.config/terminator/config

# Create enhanced XFCE4 autostart entry with reliability features
RUN cat > /home/Aortz/.config/autostart/terminator.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Terminator Multi-Drone Development
Exec=/usr/local/bin/terminator-autostart-wrapper
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
StartupNotify=false
Comment=Auto-launch Terminator with multi-drone ROS2 development layout
Categories=Development;TerminalEmulator;
Icon=terminator
OnlyShowIn=XFCE;
EOF

# Create reliable autostart wrapper script with runtime config override
RUN cat > /usr/local/bin/terminator-autostart-wrapper << 'EOF'
#!/bin/bash
# Reliable Terminator autostart wrapper with volume persistence bypass and config override

LOGFILE="/home/Aortz/.terminator-autostart.log"
MAX_RETRIES=5
RETRY_DELAY=2
ENHANCED_CONFIG="/etc/terminator-config-enhanced"
USER_CONFIG="/home/Aortz/.config/terminator/config"

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOGFILE"
}

override_terminator_config() {
    log_message "Applying enhanced Terminator configuration override..."

    # Check if enhanced config exists
    if [ -f "$ENHANCED_CONFIG" ]; then
        # Ensure config directory exists
        mkdir -p "$(dirname "$USER_CONFIG")"

        # Copy enhanced config, bypassing volume persistence
        cp "$ENHANCED_CONFIG" "$USER_CONFIG" 2>/dev/null || {
            log_message "Failed to copy enhanced config, attempting with sudo..."
            sudo cp "$ENHANCED_CONFIG" "$USER_CONFIG" 2>/dev/null || {
                log_message "Failed to override config even with sudo"
                return 1
            }
        }

        # Set proper ownership and permissions
        chown Aortz:Aortz "$USER_CONFIG" 2>/dev/null || sudo chown Aortz:Aortz "$USER_CONFIG"
        chmod 644 "$USER_CONFIG"

        # Verify config was applied
        local config_size=$(wc -c < "$USER_CONFIG" 2>/dev/null || echo "0")
        if [ "$config_size" -gt 1000 ]; then
            log_message "Enhanced config applied successfully (${config_size} bytes)"
            return 0
        else
            log_message "Config appears too small (${config_size} bytes), may not have applied correctly"
            return 1
        fi
    else
        log_message "Enhanced config file not found at $ENHANCED_CONFIG"
        return 1
    fi
}

check_environment() {
    # Check if DISPLAY is set
    if [ -z "$DISPLAY" ]; then
        log_message "DISPLAY not set, attempting to set to :1"
        export DISPLAY=:1
    fi

    # Check if X11 is responsive
    if ! xdpyinfo >/dev/null 2>&1; then
        log_message "X11 display not ready"
        return 1
    fi

    # Check if XFCE4 desktop is running
    if ! pgrep -x "xfce4-session" >/dev/null; then
        log_message "XFCE4 session not ready"
        return 1
    fi

    log_message "Environment validation passed"
    return 0
}

launch_terminator() {
    log_message "Attempting to launch Terminator with enhanced configuration..."

    # Set up environment
    export TERM=xterm-256color
    export COLORTERM=truecolor
    cd /airsim_ros2_ws

    # Source ROS2 environment
    source /opt/ros/humble/setup.bash 2>/dev/null
    source /airsim_ros2_ws/install/setup.bash 2>/dev/null || true

    # Launch Terminator in background with specific layout
    nohup terminator --layout=default --title="Multi-Drone ROS2 Development Environment" --maximise >/dev/null 2>&1 &

    # Wait a moment and check if it started
    sleep 2
    if pgrep -f "terminator.*layout=default" >/dev/null; then
        log_message "Terminator launched successfully with enhanced layout"
        return 0
    else
        log_message "Terminator failed to start"
        return 1
    fi
}

# Main execution with config override and retry logic
log_message "Starting enhanced Terminator autostart process"
log_message "System info: Docker volume persistence bypass enabled"

# Apply enhanced configuration override first
if override_terminator_config; then
    log_message "Configuration override successful, proceeding with launch"
else
    log_message "Configuration override failed, continuing with fallback"
fi

for attempt in $(seq 1 $MAX_RETRIES); do
    log_message "Attempt $attempt of $MAX_RETRIES"

    if check_environment; then
        if launch_terminator; then
            log_message "Enhanced Terminator autostart completed successfully"
            log_message "🏆 4-tab multi-drone development environment ready"
            exit 0
        fi
    fi

    if [ $attempt -lt $MAX_RETRIES ]; then
        log_message "⏳ Retrying in ${RETRY_DELAY} seconds..."
        sleep $RETRY_DELAY
    fi
done

log_message "😞 Terminator autostart failed after $MAX_RETRIES attempts"
log_message "🔧 Manual launch available: run 'terminator-multi-drone' or 'term'"
log_message "🔍 Debug: Check 'terminator-log' for details"
exit 1
EOF

RUN chmod +x /usr/local/bin/terminator-autostart-wrapper

# Create enhanced Terminator launcher script with config override
RUN cat > /usr/local/bin/terminator-multi-drone << 'EOF'
#!/bin/bash
# Enhanced Terminator launcher for multi-drone ROS2 development with config override

ENHANCED_CONFIG="/etc/terminator-config-enhanced"
USER_CONFIG="/home/Aortz/.config/terminator/config"

echo "Starting Terminator with Enhanced Multi-Drone ROS2 Development Layout..."

# Apply enhanced configuration override
echo "Applying enhanced configuration..."
if [ -f "$ENHANCED_CONFIG" ]; then
    mkdir -p "$(dirname "$USER_CONFIG")"
    cp "$ENHANCED_CONFIG" "$USER_CONFIG" 2>/dev/null || sudo cp "$ENHANCED_CONFIG" "$USER_CONFIG"
    chown Aortz:Aortz "$USER_CONFIG" 2>/dev/null || sudo chown Aortz:Aortz "$USER_CONFIG"
    chmod 644 "$USER_CONFIG"

    config_size=$(wc -c < "$USER_CONFIG" 2>/dev/null || echo "0")
    echo "Enhanced config applied (${config_size} bytes)"
else
    echo "Enhanced config not found, using existing configuration"
fi

cd /airsim_ros2_ws

# Source ROS2 environment
source /opt/ros/humble/setup.bash 2>/dev/null
source /airsim_ros2_ws/install/setup.bash 2>/dev/null || true

# Launch Terminator with enhanced settings
export TERM=xterm-256color
export COLORTERM=truecolor

echo "🏆 Launching 4-tab multi-drone development environment..."
terminator --layout=default --title="Multi-Drone ROS2 Development Environment" --maximise
EOF

RUN chmod +x /usr/local/bin/terminator-multi-drone

# Create session-based Terminator launcher as additional fallback
RUN cat > /home/Aortz/.config/autostart/terminator-session-launcher.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Terminator Session Launcher
Exec=/usr/local/bin/terminator-session-launcher
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
StartupNotify=false
Comment=Session-based Terminator launcher (fallback mechanism)
Categories=Development;TerminalEmulator;
OnlyShowIn=XFCE;
EOF

# Create session-based launcher script
RUN cat > /usr/local/bin/terminator-session-launcher << 'EOF'
#!/bin/bash
# Session-based Terminator launcher (secondary fallback)

LOGFILE="/home/Aortz/.terminator-autostart.log"

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] SESSION: $1" >> "$LOGFILE"
}

# Wait a bit more for session to stabilize
sleep 3

# Check if Terminator is already running
if pgrep -f "terminator.*layout=default" >/dev/null; then
    log_message "Terminator already running, session launcher not needed"
    exit 0
fi

log_message "Session launcher: No Terminator detected, launching..."

# Set environment
export DISPLAY=:1
export TERM=xterm-256color
export COLORTERM=truecolor
cd /airsim_ros2_ws

# Source ROS2 environment
source /opt/ros/humble/setup.bash 2>/dev/null
source /airsim_ros2_ws/install/setup.bash 2>/dev/null || true

# Final attempt to launch Terminator
nohup terminator --layout=default --title="Multi-Drone ROS2 Development Environment" --maximise >/dev/null 2>&1 &

sleep 2
if pgrep -f "terminator.*layout=default" >/dev/null; then
    log_message "Session launcher: Terminator started successfully"
else
    log_message "Session launcher: Failed to start Terminator"
fi
EOF

RUN chmod +x /usr/local/bin/terminator-session-launcher

# Add simplified Terminator aliases and environment to user bashrc
RUN cat >> /home/Aortz/.bashrc << 'EOF'

# ===============================================
# Terminator Multi-Drone Development Shortcuts
# ===============================================
alias term='terminator --layout=default'
alias multi-drone='terminator-multi-drone'
alias drone-term='terminator --layout=default --title="Multi-Drone Development"'

# Enhanced terminal environment
export TERM=xterm-256color
export COLORTERM=truecolor

# Quick ROS2 development aliases
alias launch-mission='ros2 launch airsim_ros_pkgs rpc_dynamic_vehicles.launch.py mission_mode:=true'
alias launch-rviz='rviz2 -d /airsim_ros2_ws/src/airsim_ros_pkgs/rviz/lidar_visualization.rviz'
alias monitor-drones='ros2 topic list | grep -E "(PX4_Drone|odom|mission)"'

# ===============================================
# Debug Utilities (Simple versions)
# ===============================================
alias terminator-log='tail -f /home/Aortz/.terminator-autostart.log'
alias terminator-restart='pkill -f terminator; sleep 1; terminator-multi-drone &'
alias terminator-debug='terminator-config-debug'

# Create multi-line functions for complex operations to avoid long aliases
terminator-status() {
    echo "🔍 Enhanced Terminator Status Check:"
    echo ""
    echo "Process Status:"
    pgrep -f terminator || echo "No Terminator processes found"
    echo ""
    echo "📋 Configuration Status:"
    [ -f /etc/terminator-config-enhanced ] && echo "Enhanced config available" || echo "Enhanced config missing"
    local CONFIG_SIZE
    CONFIG_SIZE=$(wc -c < /home/Aortz/.config/terminator/config 2>/dev/null || echo "0")
    echo "📄 Current config size: ${CONFIG_SIZE} bytes"
    [ "$CONFIG_SIZE" -gt 1000 ] && echo "Enhanced config appears applied" || echo "Basic config detected"
    echo ""
    echo "📋 Recent Autostart Log:"
    tail -10 /home/Aortz/.terminator-autostart.log 2>/dev/null || echo "No log file found"
}

terminator-force-config() {
    echo "🔧 Force applying enhanced 2-tab configuration..."

    local ENHANCED_CONFIG="/etc/terminator-config-enhanced"
    local USER_CONFIG="/home/Aortz/.config/terminator/config"

    # Detailed diagnostic information
    echo "📊 Configuration diagnostic:"
    echo "   Enhanced config file: $ENHANCED_CONFIG"
    echo "   User config file: $USER_CONFIG"

    if [ -f "$ENHANCED_CONFIG" ]; then
        local enhanced_size=$(wc -c < "$ENHANCED_CONFIG" 2>/dev/null || echo "0")
        local enhanced_lines=$(wc -l < "$ENHANCED_CONFIG" 2>/dev/null || echo "0")
        echo "   📄 Enhanced config: ${enhanced_size} bytes, ${enhanced_lines} lines"

        # Check for 2-tab indicators
        if grep -q "ROS2 Development" "$ENHANCED_CONFIG"; then
            echo "   ✅ Found 'ROS2 Development' tab label"
        else
            echo "   ❌ Missing 'ROS2 Development' tab label"
        fi

        if grep -q "ros2 launch airsim_ros_pkgs rpc_dynamic_vehicles.launch.py mission_mode:=true" "$ENHANCED_CONFIG"; then
            echo "   ✅ Found ROS2 launch command"
        else
            echo "   ❌ Missing ROS2 launch command"
        fi

        if grep -q "rviz2 -d /airsim_ros2_ws/src/airsim_ros_pkgs/rviz/lidar_visualization.rviz" "$ENHANCED_CONFIG"; then
            echo "   ✅ Found RViz command"
        else
            echo "   ❌ Missing RViz command"
        fi

        # Apply configuration
        mkdir -p ~/.config/terminator
        echo "🔄 Copying enhanced config..."

        if cp "$ENHANCED_CONFIG" "$USER_CONFIG" 2>/dev/null; then
            echo "   ✅ Config copied successfully"
        else
            echo "   ⚠️ Copy failed, trying with sudo..."
            sudo cp "$ENHANCED_CONFIG" "$USER_CONFIG" 2>/dev/null || {
                echo "   ❌ Failed to copy config even with sudo"
                return 1
            }
        fi

        # Set permissions
        chown Aortz:Aortz "$USER_CONFIG" 2>/dev/null || sudo chown Aortz:Aortz "$USER_CONFIG"
        chmod 644 "$USER_CONFIG"

        # Verify application
        if [ -f "$USER_CONFIG" ]; then
            local user_size=$(wc -c < "$USER_CONFIG" 2>/dev/null || echo "0")
            local user_lines=$(wc -l < "$USER_CONFIG" 2>/dev/null || echo "0")
            echo "   📄 Applied config: ${user_size} bytes, ${user_lines} lines"

            if [ "$user_size" = "$enhanced_size" ]; then
                echo "   ✅ Config sizes match - enhanced config successfully applied"
                return 0
            else
                echo "   ⚠️ Size mismatch: expected ${enhanced_size}, got ${user_size}"
                echo "   🔍 This may indicate volume persistence or permission issues"
                return 1
            fi
        else
            echo "   ❌ Config file not found after copy operation"
            return 1
        fi
    else
        echo "   ❌ Enhanced config file not found at $ENHANCED_CONFIG"
        echo "   💡 Container may need rebuilding"
        return 1
    fi
}

terminator-config-debug() {
    echo "🐛 === Terminator Configuration Debug Report ==="
    echo ""

    local ENHANCED_CONFIG="/etc/terminator-config-enhanced"
    local USER_CONFIG="/home/Aortz/.config/terminator/config"

    # File existence and permissions
    echo "📁 File Status:"
    if [ -f "$ENHANCED_CONFIG" ]; then
        local enhanced_size=$(wc -c < "$ENHANCED_CONFIG" 2>/dev/null || echo "0")
        local enhanced_lines=$(wc -l < "$ENHANCED_CONFIG" 2>/dev/null || echo "0")
        echo "   ✅ Enhanced config exists: ${enhanced_size} bytes, ${enhanced_lines} lines"
        ls -la "$ENHANCED_CONFIG"
    else
        echo "   ❌ Enhanced config MISSING at $ENHANCED_CONFIG"
        echo "      💡 Container needs rebuilding with: docker-compose build ros2-multi-node"
    fi

    if [ -f "$USER_CONFIG" ]; then
        local user_size=$(wc -c < "$USER_CONFIG" 2>/dev/null || echo "0")
        local user_lines=$(wc -l < "$USER_CONFIG" 2>/dev/null || echo "0")
        echo "   📄 User config exists: ${user_size} bytes, ${user_lines} lines"
        ls -la "$USER_CONFIG"
    else
        echo "   ⚠️ User config not found at $USER_CONFIG"
    fi

    # Configuration content analysis
    echo ""
    echo "🔍 Configuration Content Analysis:"

    if [ -f "$USER_CONFIG" ]; then
        echo "   Current user config analysis:"

        # Check for 2-tab vs 4-tab layout
        local tab_count=$(grep -c "labels.*=" "$USER_CONFIG" 2>/dev/null || echo "0")
        if grep -q "Drone Monitoring, ROS2 Development" "$USER_CONFIG"; then
            echo "   ✅ Found 2-tab layout (Drone Monitoring, ROS2 Development)"
        elif grep -q "Drone Monitoring, System Monitor, ROS2 Development, Git & Files" "$USER_CONFIG"; then
            echo "   ⚠️ Found OLD 4-tab layout - needs updating"
            echo "      💡 Run: terminator-force-config"
        else
            echo "   ❓ Unknown tab layout detected"
        fi

        # Check for specific ROS2 commands
        if grep -q "ros2 launch airsim_ros_pkgs rpc_dynamic_vehicles.launch.py mission_mode:=true" "$USER_CONFIG"; then
            echo "   ✅ Found ROS2 launch command in config"
        else
            echo "   ❌ Missing ROS2 launch command"
        fi

        if grep -q "rviz2 -d /airsim_ros2_ws/src/airsim_ros_pkgs/rviz/lidar_visualization.rviz" "$USER_CONFIG"; then
            echo "   ✅ Found RViz command in config"
        else
            echo "   ❌ Missing RViz command"
        fi

        # Check for VPaned (vertical split) in Tab 2
        if grep -A 10 -B 5 "ROS2 Development" "$USER_CONFIG" | grep -q "VPaned"; then
            echo "   ✅ Found vertical split (VPaned) for ROS2 Development tab"
        else
            echo "   ❌ Missing vertical split in ROS2 Development tab"
        fi
    fi

    # Process status
    echo ""
    echo "🖥️ Process Status:"
    if pgrep -f terminator >/dev/null; then
        echo "   ✅ Terminator is running"
        pgrep -f terminator | while read pid; do
            ps -p $pid -o pid,cmd --no-headers
        done
    else
        echo "   ❌ Terminator is not running"
    fi

    # Volume persistence check
    echo ""
    echo "💾 Volume Persistence Analysis:"
    echo "   User config directory: $(dirname "$USER_CONFIG")"
    echo "   Directory ownership: $(ls -ld "$(dirname "$USER_CONFIG")" 2>/dev/null || echo "Not found")"

    if [ -f "$USER_CONFIG" ]; then
        local config_age=$(stat -c %Y "$USER_CONFIG" 2>/dev/null || echo "unknown")
        echo "   Config last modified: $(date -d @$config_age 2>/dev/null || echo "unknown")"
    fi

    # Docker volume info
    echo "   💡 If size mismatch persists, volume reset may be needed:"
    echo "      docker-compose -f docker-compose-master.yml down"
    echo "      docker volume rm vnc_home"
    echo "      docker-compose -f docker-compose-master.yml --profile integrated up ros2-multi-node"

    echo ""
    echo "📋 Recommended Actions:"
    if [ ! -f "$ENHANCED_CONFIG" ]; then
        echo "   1. Rebuild container: docker-compose build ros2-multi-node"
    fi

    if [ -f "$USER_CONFIG" ]; then
        local user_size=$(wc -c < "$USER_CONFIG" 2>/dev/null || echo "0")
        if [ "$user_size" -lt 1000 ]; then
            echo "   2. Apply enhanced config: terminator-force-config"
        fi
    fi

    echo "   3. Restart Terminator: terminator-restart"
    echo "   4. If issues persist: fix-terminator"
}

fix-terminator() {
    echo "🔧 Comprehensive Terminator fix..."
    echo "Step 1: Killing existing Terminator processes"
    pkill -f terminator
    sleep 2

    echo "Step 2: Applying enhanced configuration"
    terminator-force-config

    echo "Step 3: Launching Terminator with enhanced environment"
    sleep 1
    export DISPLAY=:1
    cd /airsim_ros2_ws
    terminator --layout=default --maximise &

    sleep 3
    echo "Step 4: Verification"
    if pgrep -f terminator >/dev/null; then
        echo "✅ Terminator restarted successfully"
    else
        echo "❌ Terminator restart failed"
        echo "💡 Try manual debugging: terminator-config-debug"
    fi
}

EOF

# Comprehensive dos2unix conversion for all generated files - FIRST PASS
RUN dos2unix /home/Aortz/.bashrc \
    /home/Aortz/.vnc/xstartup \
    /home/Aortz/.config/autostart/*.desktop \
    /usr/local/bin/terminator-* \
    /etc/terminator-config-enhanced 2>/dev/null || true

# Additional safety measures for line ending issues
RUN find /home/Aortz/.config -name "*.desktop" -exec dos2unix {} \; 2>/dev/null || true && \
    find /usr/local/bin -name "terminator-*" -exec dos2unix {} \; 2>/dev/null || true

# Set proper ownership (single operation)
RUN chown -R Aortz:Aortz /airsim_ros2_ws /home/Aortz

# Configure optimized runtime environment paths
ENV PYTHONPATH="/opt/ros/humble/lib/python3.10/site-packages:/airsim_ros2_ws/install/airsim_interfaces/lib/python3.10/site-packages:/airsim_ros2_ws/install/airsim_ros_pkgs/lib/python3.10/site-packages:${PYTHONPATH}" \
    PATH="/opt/ros/humble/bin:/airsim_ros2_ws/install/airsim_ros_pkgs/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/ros/humble/lib:/airsim_ros2_ws/install/airsim_interfaces/lib:/airsim_ros2_ws/install/airsim_ros_pkgs/lib:${LD_LIBRARY_PATH}" \
    CMAKE_PREFIX_PATH="/opt/ros/humble:/airsim_ros2_ws/install/airsim_interfaces:/airsim_ros2_ws/install/airsim_ros_pkgs:${CMAKE_PREFIX_PATH}"

# Runtime configuration
WORKDIR /airsim_ros2_ws
VOLUME ["/airsim_ros2_ws/src"]
EXPOSE 5901 7400/udp 7401/udp 7402/udp

# Optimized health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD pgrep -f "X.*vnc.*:1" > /dev/null || exit 1

# Copy and configure entrypoint
COPY docker/airsim_ros2_wrapper/VNC/entrypoint_lightweight.sh /
RUN dos2unix /entrypoint_lightweight.sh && chmod +x /entrypoint_lightweight.sh

# Final user configuration
USER Aortz
RUN echo "cd /airsim_ros2_ws" >> /home/Aortz/.bashrc

# Switch back for entrypoint execution
USER root

ENTRYPOINT ["/entrypoint_lightweight.sh"]

# =============================================================================
# Optimization Summary:
# - Multi-stage build separates build-time vs runtime dependencies
# - Expected ~30-40% size reduction (from ~2.5GB to ~1.2-1.5GB)
# - Optimized layer structure with combined operations
# - Streamlined NumPy header management
# - Better build caching through strategic operation ordering
# - Development packages remain only in builder stage
# =============================================================================
