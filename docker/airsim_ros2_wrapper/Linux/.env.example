# ============================================
# ROS2 X11-Forwarding Environment Template
# Linux Native Performance Configuration
# ============================================
# Copy this file to .env and customize:
# cp .env.example .env

# =================================
# PROJECT CONFIGURATION (REQUIRED)
# =================================
# Absolute path to Cosys_Airsim_Exploration project root
PROJECT_ROOT=/home/mnsuser/Cosys_Airsim_Exploration

# =================================
# X11 DISPLAY CONFIGURATION
# =================================
# X11 display to forward (usually :0 or :1)
# Auto-detected from host if not set
DISPLAY=:0

# X11 authentication file path
# Auto-detected from $HOME/.Xauthority if not set
XAUTHORITY=/home/mnsuser/.Xauthority

# Fix for Qt applications in Docker (usually not needed)
QT_X11_NO_MITSHM=1

# =================================
# USER PERMISSIONS
# =================================
# Run container as host user to match X11 permissions
# Auto-detected if not set
UID=1000
GID=1000

# =================================
# AIRSIM CONNECTION
# =================================
# AirSim server hostname/IP
# Options:
#   - airsim-container     (if AirSim in Docker on same network)
#   - host.docker.internal (if AirSim on host - Windows/Mac)
#   - 172.30.0.X           (specific Docker network IP)
AIRSIM_HOST_IP=airsim-container

# AirSim RPC API port
AIRSIM_HOST_PORT=41451

# =================================
# ROS2 CONFIGURATION
# =================================
# ROS2 Domain ID for network isolation
# Use different values to separate ROS2 instances
ROS_DOMAIN_ID=0

# Multi-Node Architecture Settings
LAUNCH_MODE=multi                # Options: multi, legacy
ENABLE_COORDINATION=true         # Enable coordination node
RPC_TIMEOUT=10.0                 # RPC discovery timeout (seconds)
DEBUG=false                      # Enable debug logging

# =================================
# AUTO-BUILD CONFIGURATION
# =================================
# Automatically build workspace on container start
AUTO_BUILD=true

# Build type (Release for performance, Debug for development)
CMAKE_BUILD_TYPE=Release

# =================================
# VISUALIZATION
# =================================
# Auto-launch RViz2 on startup
LAUNCH_RVIZ=false

# =================================
# NETWORK CONFIGURATION
# =================================
# ROS2 Discovery Ports
ROS2_DISCOVERY_PORT=7400
ROS2_MULTICAST_PORT=7401

# =================================
# DOCKER COMPOSE PROJECT
# =================================
# Custom project name (optional)
COMPOSE_PROJECT_NAME=airsim-ros2-x11

# =================================
# USAGE EXAMPLES
# =================================
# Basic startup:
#   docker-compose up -d
#
# With custom AirSim host:
#   AIRSIM_HOST_IP=192.168.1.100 docker-compose up -d
#
# Different ROS2 domain:
#   ROS_DOMAIN_ID=5 docker-compose up -d
#
# Access container:
#   docker exec -it ros2-x11-node bash
#
# Launch ROS2 system:
#   docker exec ros2-x11-node ros2-system start multi
#
# Launch RViz2:
#   docker exec ros2-x11-node rviz2
