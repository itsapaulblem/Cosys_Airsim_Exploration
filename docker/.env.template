# AirSim Ecosystem Environment Configuration Template
# Copy this file to .env and customize as needed
# Usage: cp .env.template .env

# Docker Environment Configuration Example
# This file shows the environment variables required for secure Docker operation
# Copy to .env and customize with your secure values

# =======================
# REQUIRED SECURITY VARIABLES
# =======================
# PostgreSQL Database Password (REQUIRED for postgres services)
POSTGRES_PASSWORD=generate_a_secure_password_here

# pgAdmin Web Interface Password (REQUIRED for pgadmin service)
PGADMIN_PASSWORD=generate_a_secure_pgadmin_password_here

# =======================
# PROJECT CONFIGURATION
# =======================
# Project root path - UPDATE THIS to match your local path
# For WSL2/Linux:
PROJECT_ROOT=/path/to/your/Cosys_Airsim_Exploration

# =================================
# DOCKER COMPOSE PROJECT SETTINGS
# =================================
# Set custom project name (default: directory name)
COMPOSE_PROJECT_NAME=tevv-airstack

# =================================
# AIRSIM CONNECTION SETTINGS
# =================================
# AirSim API endpoint (Containerized: airsim-container, Host Windows: host.docker.internal, Host Linux: localhost)
AIRSIM_HOST_IP=airsim-container
AIRSIM_HOST_PORT=41451

# =================================  
# ROS2 CONFIGURATION
# =================================
# ROS2 Domain ID for network isolation
ROS_DOMAIN_ID=0

# Multi-node architecture settings
LAUNCH_MODE=multi                # Options: multi, legacy
ENABLE_COORDINATION=true         # Enable coordination node
RPC_TIMEOUT=10.0                 # RPC discovery timeout (seconds)
LAUNCH_RVIZ=false               # Auto-launch RViz visualization
DEBUG=false                      # Enable debug logging
AUTO_BUILD=false                 # Packages are pre-built in Docker image (no runtime build needed)

# =================================
# X11 FORWARDING (LINUX ONLY)
# =================================
# X11 Display (auto-detected from host environment)
# DISPLAY is inherited from host if not set
# XAUTHORITY is inherited from host if not set

# User ID mapping for X11 permissions (must match host user)
# Run 'id -u' and 'id -g' on host to verify your values
# Note: UID/GID must match host user for X11 forwarding permissions
# For VNC setup, default 1000:1000 is usually fine
UID=1000
GID=1000

# =================================
# PX4 SWARM CONFIGURATION  
# =================================
# PX4 simulation target (should match AirSim host)
PX4_SIM_HOSTNAME=airsim-container
PX4_SIM_MODEL=none_iris         # Vehicle model for PX4
PX4_SYS_AUTOSTART=10016         # PX4 airframe configuration

# Home position (default: Boise, Idaho)
PX4_HOME_LAT=43.06659659989448
PX4_HOME_LON=-115.85470390486812
PX4_HOME_ALT=0.0

# Swarm settings
SWARM_ID=1                      # Swarm identifier
SWARM_SIZE=3                    # Number of drones in swarm
MAX_DRONES=3                    # Maximum drones to spawn (1-6 supported)

# =================================
# DEVELOPMENT SETTINGS
# =================================
# VNC Configuration (for ROS2 container)
VNC_PORT=5901
RESOLUTION=1920x1080
VNC_USER=Aortz
VNC_PASSWD=ubuntu

# =================================
# NETWORK SETTINGS
# =================================
# Port ranges for PX4 MAVLink
PX4_TCP_BASE_PORT=4560          # Base port for PX4 TCP connections
PX4_UDP_BASE_PORT=14550         # Base port for QGroundControl UDP

# ROS2 Discovery ports
ROS2_DISCOVERY_PORT=7400
ROS2_MULTICAST_PORT=7401

# =================================
# AIRSIM DOCKERFILE SETTINGS
# =================================

DOCKER_IMAGE_NAME=airsim_binary:22.04-vulkan-x11
#DOCKER_IMAGE_NAME=airsim_binary:cuda-13.0.1-u22.04
#DOCKER_IMAGE_NAME=airsim_binary:runtime
UNREAL_BINARY_PATH=/home/mnsuser/Cosys_Airsim_Exploration/docker/unreal_executable/packaged
UNREAL_BINARY_SHELL_ABSPATH=/home/mnsuser/Cosys_Airsim_Exploration/docker/unreal_executable/packaged/Blocks.sh
# UNREAL_BINARY_PATH=/home/mnsuser/Cosys_Airsim_Exploration/docker/unreal_executable/packaged-sm6/Linux
# UNREAL_BINARY_SHELL_ABSPATH=/home/mnsuser/Cosys_Airsim_Exploration/docker/unreal_executable/packaged-sm6/Linux/Blocks.sh

# Rendering Window GUI
UNREAL_ARG1=-windowed
UNREAL_ARG2=-ResX=1080
UNREAL_ARG3=-ResY=720

# UNREAL_ARG1=-RenderOffScreen
# UNREAL_ARG2=
# UNREAL_ARG3=
# XAUTHORITY_FILE=/run/user/1000/gdm/Xauthority
UID=1000
GID=1000
DISPLAY=:0  # Adjust if necessary

# =================================
# DOCKER COMPOSE PROFILES & USAGE
# =================================
# Available profiles:
# - ros2-only     : Just ROS2 multi-node system
# - px4-only      : Just PX4 swarm (configurable count)  
# - integrated    : Full ecosystem with monitoring
# - development   : Full system + development tools

# =================================
# CONFIGURABLE DRONE USAGE EXAMPLES
# =================================
# 1. Default 3-drone setup:
#    docker-compose -f docker-compose-master.yml --profile integrated up
#
# 2. Single drone testing:
#    docker-compose -f docker-compose-master.yml --profile integrated up px4-bridge-drone-1 ros2-multi-node wsl2-ip-detector
#
# 3. Large swarm (6 drones) - specify each drone:
#    docker-compose -f docker-compose-master.yml --profile integrated up px4-bridge-drone-1 px4-bridge-drone-2 px4-bridge-drone-3 px4-bridge-drone-4 px4-bridge-drone-5 px4-bridge-drone-6 ros2-multi-node wsl2-ip-detector
#
# 4. Custom drone subset (e.g., drones 1, 3, 5):
#    docker-compose -f docker-compose-master.yml --profile integrated up px4-bridge-drone-1 px4-bridge-drone-3 px4-bridge-drone-5 ros2-multi-node wsl2-ip-detector
#
# 5. ROS2 only (no PX4):
#    docker-compose -f docker-compose-master.yml --profile ros2-only up
#
# Note: PX4 SITL instances use consecutive instance IDs:
#       - px4-bridge-drone-1 = instance 0 (ports: 4560/tcp, 14550/udp)
#       - px4-bridge-drone-2 = instance 1 (ports: 4561/tcp, 14551/udp)
#       - px4-bridge-drone-3 = instance 2 (ports: 4562/tcp, 14552/udp)
#       - px4-bridge-drone-4 = instance 3 (ports: 4563/tcp, 14553/udp)
#       - px4-bridge-drone-5 = instance 4 (ports: 4564/tcp, 14554/udp)
#       - px4-bridge-drone-6 = instance 5 (ports: 4565/tcp, 14555/udp)