<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_search_interfaces</name>
  <version>1.0.0</version>
  <description>ROS2 interfaces for mission-based search operations in ultra-clean multi-node architecture</description>
  
  <maintainer email="developer@cosys-lab.org">Cosys-Lab Developer</maintainer>
  <license>MIT</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Interface generation dependencies -->
  <build_depend>rosidl_default_generators</build_depend>
  
  <!-- Runtime dependencies for generated interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  
  <!-- Standard message dependencies -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>builtin_interfaces</depend>
  
  <!-- Interface generation -->
  <member_of_group>rosidl_interface_packages</member_of_group>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>